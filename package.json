{
  "name": "synkenpluz",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "start": "node --import tsx src/main.ts",
    "admin": "node --import tsx scripts/admin.ts",
    "demo": "node --import tsx scripts/demo.ts",
    "smoke": "bash scripts/smoke.sh",
    "test:pg": "bash scripts/pg-test.sh",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/src/main.js",
    "admin:prod": "node dist/scripts/admin.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
