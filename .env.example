# Kopiera till .env och fyll i. .env får ALDRIG committas (finns i .gitignore).
# Generera hemligheter med openssl, använd olika värden i varje miljö.

# --- Obligatoriskt -------------------------------------------------------------------------------
# Postgres. Med docker-compose sätts denna automatiskt, men den måste finnas för `npm start`.
DATABASE_URL=postgres://synkenpluz:byt-mig@localhost:5432/synkenpluz

# Server-pepper för API-nycklar, 32 byte. Generera:  openssl rand -hex 32
# VARNING: byte av pepper ogiltigförklarar ALLA utfärdade API-nycklar.
API_KEY_PEPPER=

# Huvudnycklar för kryptering av åtkomsttoken, "id:nyckel" (nyckel = 32 byte, 64 hextecken).
# Flera nycklar separeras med komma, den FÖRSTA är aktuell (för rotation). Generera:  openssl rand -hex 32
# Exempel:  MASTER_KEYS=k1:0123...abcd
MASTER_KEYS=

# --- Valfritt ------------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# Körcykelns intervall i millisekunder. 0 = bara API, ingen synk och ingen bokföring.
CYCLE_INTERVAL_MS=60000

# Larm: Slack-kompatibel webhook. Adressen är en hemlighet. Utelämnas den loggas larm bara.
ALERT_WEBHOOK_URL=
ALERT_LABEL=prod

# GET /metrics (Prometheus). Minst 24 tecken. Utelämnas den finns inte /metrics.  openssl rand -hex 24
METRICS_TOKEN=
